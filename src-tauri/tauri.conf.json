{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sptmod",
  "identifier": "de.baumm.sptmod",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sptmod",
        "width": 1100,
        "height": 760,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDMjBCQTkyMDVCRTM4QzYKUldUR09MNEZrcm9nSEIzSzJJTjlmNUJNeWpseFRKSmVIUjNWTGFwcDVZVnU0YVhoYktleFZDNDEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "sidecar/sptmod": "sidecar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      }
    }
  }
}
